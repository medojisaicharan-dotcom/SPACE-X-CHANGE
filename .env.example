# ---------------------------------------------------------------------------
# SPACEXCHANGE environment configuration
# ---------------------------------------------------------------------------
# The app runs in LOCAL DEMO MODE when these values are absent or left blank.
# When VITE_SUPABASE_URL and a publishable/anon key are present, the app uses
# Supabase Auth and Postgres instead.
#
# NEVER put the Supabase service-role or secret key in this file or in frontend
# code. Only the publishable/anon key belongs in the browser. The service-role
# key is only read by scripts/seed-supabase.mjs, from your local shell.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
# Prefer the project's publishable key. The legacy anon JWT is also supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional. Set to "demo" to force the browser-only driver even when Supabase
# credentials above are configured.
VITE_DATA_MODE=

# Reserved for a future AI integration. These values are not read by the
# current build, which uses the built-in transparent rule-based assistant.
VITE_AI_API_URL=
VITE_AI_API_KEY=
